# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# --- Confidence threshold for the Streamlit app (0.0 – 1.0) ---
CONFIDENCE_THRESHOLD=0.70

# --- Optional LLM for treatment advice ---
# Leave LLM_PROVIDER empty to use the built-in local advice dictionary.

# Option A: IBM watsonx.ai
# LLM_PROVIDER=watsonx
# WATSONX_API_KEY=your_api_key_here
# WATSONX_PROJECT_ID=your_project_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Option B: OpenAI-compatible endpoint
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=https://api.openai.com/v1
